# Copie para .env.local (local) e/ou configure em Vercel > Settings > Environment Variables.

# --- Contagem regressiva (frontend) ---
# Data alvo em ISO 8601 com fuso. Sem isso, usa o padrão de src/config.js.
VITE_TARGET_DATE="2026-09-28T23:59:59-03:00"
VITE_TITLE="Contagem regressiva para Liberdade de Hugo"
VITE_SUBTITLE="A liberdade está chegando #HugoLivre"
VITE_DONE_MESSAGE="A liberdade chegou"

# --- Banco dos comentários (backend) ---
# Criado automaticamente ao adicionar Upstash Redis pelo Marketplace da Vercel.
# Se estas duas variáveis não existirem, a API guarda tudo em memória (só dev).
KV_REST_API_URL=""
KV_REST_API_TOKEN=""

# Alternativa: variáveis nativas do Upstash (também aceitas)
# UPSTASH_REDIS_REST_URL=""
# UPSTASH_REDIS_REST_TOKEN=""

# --- Reset dos comentários ---
# Qualquer string secreta. Sem ela, o endpoint DELETE fica desativado.
RESET_TOKEN=""
